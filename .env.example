# LivingOps AI configuration. Copy to .env and fill in real values locally.
# Never commit .env or paste real values into code, docs or chat.

APP_NAME=LivingOps AI
APP_ENV=development

# PostgreSQL (Supabase). The backend switches postgresql:// to psycopg 3.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Qdrant Cloud
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io
QDRANT_API_KEY=<qdrant-api-key>
QDRANT_POLICY_COLLECTION=policy_knowledge_v1

# OpenAI
OPENAI_API_KEY=<openai-api-key>
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# n8n (Render). The token is sent as the exact Authorization header value.
N8N_PROVISIONING_WEBHOOK=https://<n8n-host>/webhook/livingops-executor
N8N_SHARED_TOKEN=<shared-header-token>
N8N_NOTIFIER_WEBHOOK=https://<n8n-host>/webhook/livingops-notifier
REQUEST_TIMEOUT_SECONDS=30

# GitHub demo organization. READ-ONLY token only; the write token lives in n8n.
GITHUB_ORG=<demo-org>
GITHUB_REPO=aurora
GITHUB_READ_TOKEN=<fine-grained-read-only-token>
GITHUB_ARIF_USERNAME=<arif-test-account>

# LIVE | CACHED_AI | OFFLINE
DEMO_MODE=LIVE
# Shared secret for the n8n expiry sweeper and the MCP adapter.
MCP_SERVICE_TOKEN=<random-service-token>
# Used in notification links.
APP_BASE_URL=http://127.0.0.1:5173
# MCP identity of Aurora Release Bot (random string); only its hash is stored.
AURORA_BOT_MCP_KEY=<random-agent-key>
