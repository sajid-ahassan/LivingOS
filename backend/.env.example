APP_NAME=LivingOps AI
APP_ENV=development

DATABASE_URL=postgresql+psycopg://postgres.project_ref:password@pooler.example.com:5432/postgres

QDRANT_URL=https://replace-me.qdrant.io
QDRANT_API_KEY=replace_me
QDRANT_POLICY_COLLECTION=policy_knowledge_v1

OPENAI_API_KEY=replace_me
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_DIMENSION=1536

N8N_PROVISIONING_WEBHOOK=https://replace-me.example.com/webhook/livingops-provision
N8N_SHARED_TOKEN=replace_with_the_exact_n8n_authorization_value
REQUEST_TIMEOUT_SECONDS=30
